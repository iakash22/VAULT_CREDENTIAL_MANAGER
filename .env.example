# Copy this file to .env and fill in local values.
# NEVER commit .env — it can contain credentials.
# Production template: .env.production.example — see docs/DEPLOYMENT.md

NODE_ENV=development

# Production only — public hostname for TLS + CORS
# VAULT_DOMAIN=vault.example.com

# API
API_HOST=0.0.0.0
API_PORT=3001
CORS_ORIGIN=http://localhost:5173

# Web (leave empty in local Vite so /api is proxied to the API)
VITE_API_BASE_URL=

# Brute-force / abuse protection (global). Auth routes will be stricter in Phase 2.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# PostgreSQL (docker compose service name is "postgres")
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-this-dev-password
POSTGRES_DB=vault
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vault:change-this-dev-password@localhost:5432/vault

# JWT (15 minutes). Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-value-before-phase-2
JWT_EXPIRES_SEC=900
AUTH_LOCKOUT_THRESHOLD=8
AUTH_LOCKOUT_MINUTES=15
SINGLE_USER_MODE=true

# Web security (Vite — rebuild after change)
VITE_IDLE_LOCK_MINUTES=15
VITE_JWT_REFRESH_BEFORE_SEC=120
VITE_CLIPBOARD_CLEAR_MS=30000
