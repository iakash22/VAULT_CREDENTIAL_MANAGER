{
  "name": "vault-credential-manager",
  "private": true,
  "version": "0.1.0",
  "description": "Self-hosted zero-knowledge secrets manager",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "dev:web": "npm run dev -w @vault/web",
    "dev:api": "npm run dev -w @vault/api",
    "dev:db": "docker compose up postgres",
    "docker:full": "docker compose --profile full up -d --build",
    "docker:prod": "docker compose -f docker-compose.yml -f docker-compose.prod.yml --profile production up -d --build",
    "db:generate": "npm run db:generate -w @vault/api",
    "db:migrate": "npm run db:migrate -w @vault/api",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.19.0"
  }
}
